<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Avatar Bot -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_badge_income">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bot_ai" />
    </FrameLayout>

    <!-- Thân tin nhắn Bot -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bot"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_bot_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Xin chào! Tôi có thể giúp gì cho bạn?"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Card xác nhận giao dịch (hiển thị khi bot bóc tách được giao dịch) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_confirmation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_confirm_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ăn uống: 45.000 VNĐ"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Các nút xác nhận hoặc hủy -->
                    <LinearLayout
                        android:id="@+id/layout_action_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel_transaction"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:padding="0dp"
                            android:text="Hủy"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:strokeColor="@color/border" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_confirm_transaction"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/primary"
                            android:padding="0dp"
                            android:text="Xác nhận lưu"
                            android:textColor="@color/text_white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Trạng thái sau khi bấm nút -->
                    <TextView
                        android:id="@+id/tv_confirmation_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="✅ Đã lưu vào sổ chi tiêu"
                        android:textColor="@color/income_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_bot_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="15:30"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
