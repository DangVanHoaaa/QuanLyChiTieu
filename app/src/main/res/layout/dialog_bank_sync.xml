<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_rounded_card"
    android:padding="20dp">

    <!-- Tiêu đề Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_bank"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Tự động đọc thông báo ngân hàng"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider" />

    <!-- Công tắc BẬT / TẮT tính năng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kích hoạt tự động ghi nhận"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tự động phân tích biến động số dư và thêm giao dịch vào ví"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_bank_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Trạng thái quyền truy cập thông báo -->
    <LinearLayout
        android:id="@+id/layout_permission_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_badge_warning"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_permission_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/warning_orange" />

            <TextView
                android:id="@+id/tv_permission_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Chưa cấp quyền đọc thông báo"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_permission_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Để tự động nhận diện giao dịch từ app ngân hàng, bạn cần cho phép Ví Thông Minh quyền truy cập thông báo.\n(Lưu ý: Trên Android 13/14 nếu nút bị mờ, vào Cài đặt máy > Ứng dụng > Ví Thông Minh > Bấm 3 chấm góc trên > Chọn 'Cho phép cài đặt bị hạn chế')."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_grant_permission"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="CẤP QUYỀN TRUY CẬP THÔNG BÁO"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khu vực Dán tin nhắn SMS / Thông báo thủ công -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Dán tin nhắn SMS / Thông báo ngân hàng:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hỗ trợ tin nhắn SMS Banking hoặc khi máy không cho đọc thông báo:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/et_paste_bank_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_search"
            android:hint="Dán nội dung tin nhắn SMS hoặc thông báo tại đây... (Ví dụ: TK 1234xxx - 150,000VND. ND: Highlands Coffee...)"
            android:padding="10dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_parse_pasted_sms"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="PHÂN TÍCH &amp; DUYỆT GIAO DỊCH"
            android:textColor="@color/surface_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khu vực thử nghiệm nhanh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_rounded_search"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Thử nghiệm giao dịch mẫu:"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chọn giao dịch mẫu để trải nghiệm quy trình duyệt &amp; phân loại:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/sp_sample_transaction"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_rounded_card" />

        <Button
            android:id="@+id/btn_test_bank_sync"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="TẠO GIAO DỊCH MẪU &amp; DUYỆT NGAY"
            android:textColor="@color/surface_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Danh sách các ngân hàng hỗ trợ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Ngân hàng &amp; Ví điện tử hỗ trợ:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="Vietcombank, MB Bank, Techcombank, VPBank, ACB, BIDV, Agribank, TPBank, Ví MoMo, ZaloPay, Viettel Money, Cake, Timo, Sacombank, VIB..."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Nút Đóng -->
    <Button
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/divider"
        android:text="ĐÓNG"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
